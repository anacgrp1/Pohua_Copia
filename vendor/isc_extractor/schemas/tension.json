{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resorte de tension/extension - Schema v4 (fusion ISC)",
  "type": "object",
  "properties": {
    "tipo_resorte": {
      "type": "string",
      "const": "tension"
    },
    "tipo_detectado": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compresion",
        "tension",
        "torsion",
        "wireform",
        null
      ],
      "description": "Tipo que TU ves en el plano. Normalmente coincide con el que se te indico; ponlo distinto solo si el plano te contradice claramente."
    },
    "identificacion": {
      "type": "object"
    },
    "material": {
      "type": "object"
    },
    "dimensiones_mm": {
      "type": "object",
      "properties": {
        "diametro_exterior": {
          "$ref": "#/definitions/cota"
        },
        "diametro_interior": {
          "$ref": "#/definitions/cota"
        },
        "diametro_medio": {
          "$ref": "#/definitions/cota"
        },
        "diametro_alambre": {
          "$ref": "#/definitions/cota"
        },
        "longitud_libre_L0": {
          "$ref": "#/definitions/cota",
          "description": "Longitud libre TOTAL en estado libre, de extremo exterior a extremo exterior de los ganchos (overall)."
        },
        "longitud_entre_ganchos_LBH": {
          "$ref": "#/definitions/cota",
          "description": "Length between hooks (LBH): distancia INTERIOR entre los ganchos en estado libre. Es una cota DISTINTA de la longitud libre total; muchos planos dan las dos."
        },
        "longitud_cuerpo": {
          "$ref": "#/definitions/cota",
          "description": "Longitud del cuerpo enrollado, sin ganchos."
        },
        "paso": {
          "$ref": "#/definitions/cota"
        }
      },
      "additionalProperties": false
    },
    "espiras": {
      "type": "object",
      "properties": {
        "numero_espiras_totales": {
          "type": [
            "number",
            "null"
          ]
        },
        "numero_espiras_activas": {
          "type": [
            "number",
            "null"
          ]
        },
        "sentido_enrollado": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "derecho",
            "izquierdo",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "ganchos": {
      "type": "object",
      "properties": {
        "tipo": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ej. 'gancho redondo', 'lazo aleman', 'gancho extendido', 'L-hook'."
        },
        "geometria": {
          "type": [
            "string",
            "null"
          ],
          "description": "Descripcion textual de la geometria del gancho."
        },
        "angulo_entre_ganchos_grados": {
          "type": [
            "number",
            "null"
          ],
          "description": "Angulo formado entre los dos ganchos en estado libre."
        },
        "angulo_entre_ganchos_tolerancia_grados": {
          "type": [
            "number",
            "null"
          ]
        },
        "radio_gancho_mm": {
          "$ref": "#/definitions/cota"
        }
      },
      "additionalProperties": false
    },
    "cargas": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/carga_lineal"
      }
    },
    "pretension_N": {
      "type": [
        "number",
        "null"
      ],
      "description": "Tension inicial (initial tension): fuerza minima necesaria para iniciar la extension del resorte desde L0. Caracteristica unica de resortes de extension."
    },
    "rigidez_lineal_N_por_mm": {
      "type": [
        "number",
        "null"
      ]
    },
    "esfuerzo_trabajo_MPa": {
      "type": [
        "number",
        "null"
      ]
    },
    "carrera_trabajo_mm": {
      "$ref": "#/definitions/cota"
    },
    "condiciones_operacion": {
      "type": "object"
    },
    "caracteristicas_clasificadas": {
      "type": "array"
    },
    "notas_generales": {
      "type": "array"
    },
    "historial_revisiones": {
      "type": "array"
    },
    "metadatos_extraccion": {
      "type": "object"
    },
    "normas_aplicables": {
      "type": "array",
      "description": "Lista consolidada de todas las normas mencionadas en el plano, con tipo (enum), descripcion y origen (donde aparece en el plano).",
      "items": {
        "type": "object",
        "properties": {
          "norma": {
            "type": "string",
            "description": "Nombre o codigo de la norma tal como aparece en el plano (ej. \"DIN 50938 Fe//A/T4\")."
          },
          "tipo": {
            "type": "string",
            "enum": [
              "material",
              "acabado",
              "tolerancia",
              "dibujo",
              "ensayo",
              "calidad",
              "interno",
              "roscas"
            ],
            "description": "Categoria de la norma."
          },
          "descripcion": {
            "type": [
              "string",
              "null"
            ],
            "description": "Que cubre la norma en lenguaje natural breve."
          },
          "origen": {
            "type": [
              "string",
              "null"
            ],
            "description": "De que parte del plano viene (ej. \"Nota 3\", \"Cajetin / material\", \"Tabla especificaciones fila 114\", \"Bloque de revisiones\")."
          }
        },
        "required": [
          "norma",
          "tipo"
        ],
        "additionalProperties": false
      }
    },
    "localizacion": {
      "type": "array",
      "description": "Ubicacion en el plano de los datos clave, para recortes de verificacion. Solo campos que el cotizador usa + los items de feasibility.",
      "items": {
        "type": "object",
        "properties": {
          "campo": {
            "type": "string",
            "description": "Ruta JSON del dato, ej. 'dimensiones_mm.diametro_alambre' o 'cargas[0]'."
          },
          "pagina": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Indice de pagina base 0."
          },
          "word_indices": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "nbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "campo"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tipo_resorte"
  ],
  "additionalProperties": false,
  "definitions": {
    "cota": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "nominal": {
              "type": [
                "number",
                "null"
              ]
            },
            "tolerancia_mas": {
              "type": [
                "number",
                "null"
              ],
              "description": "MAGNITUD positiva de la tolerancia superior. El limite alto es nominal + tolerancia_mas. Nunca negativa."
            },
            "tolerancia_menos": {
              "type": [
                "number",
                "null"
              ],
              "description": "MAGNITUD positiva de la tolerancia inferior. El limite bajo es nominal - tolerancia_menos. NUNCA se escribe con signo negativo."
            },
            "valor_maximo": {
              "type": [
                "number",
                "null"
              ]
            },
            "valor_minimo": {
              "type": [
                "number",
                "null"
              ]
            },
            "es_referencia": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "texto_original": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "carga_lineal": {
      "type": "object",
      "properties": {
        "etiqueta": {
          "type": [
            "string",
            "null"
          ]
        },
        "longitud_mm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Longitud total entre ganchos en este punto de carga."
        },
        "fuerza_N": {
          "type": [
            "number",
            "null"
          ]
        },
        "unidad_fuerza_original": {
          "type": [
            "string",
            "null"
          ]
        },
        "deflexion_mm": {
          "type": [
            "number",
            "null"
          ],
          "description": "Estiramiento respecto a L0."
        },
        "tolerancia_fuerza_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "tolerancia_fuerza_absoluta_N": {
          "type": [
            "number",
            "null"
          ]
        },
        "condiciones_medicion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}