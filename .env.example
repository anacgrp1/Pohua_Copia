# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# ==============================================================================
# dev | prod.  Con APP_ENV=prod la app NO arranca si faltan los secretos de
# abajo (JWT_SECRET, WORKER_SECRET_KEY, DATABASE_URL): es deliberado.
APP_ENV=dev

# ==============================================================================
# CONEXIÓN A BASE DE DATOS (NEON)
# ==============================================================================
# En Neon, prefiere el endpoint con "-pooler" en el host: la aplicación abre y
# cierra conexiones por operación y el pooler evita agotar el límite de la rama.
DATABASE_URL=

# Al arrancar, la API aplica el esquema y las migraciones que le falten a la
# base y apunta cuáles ya están en la tabla `schema_migraciones`. Así el esquema
# viaja con el código: si la aplicación arranca, su base tiene lo que ese código
# necesita. Ponlo en false para aplicarlas a mano o dejárselo al workflow.
AUTO_MIGRAR=true

# ==============================================================================
# SEGURIDAD DE LA API  (COT-100)
# ==============================================================================
# Clave con la que se firman los tokens de sesión. Obligatoria en prod.
# Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Duración de la sesión en minutos (480 = 8 h, una jornada).
JWT_EXPIRE_MINUTES=480
# Orígenes permitidos por CORS, separados por coma. Déjala VACÍA salvo que
# sirvas el frontend desde otro dominio; la PWA va en el mismo servidor.
# No se admite "*" en producción.
CORS_ORIGINS=

# Secreto compartido con la app de escritorio para su heartbeat. Obligatorio en
# prod. Si se deja vacío, el endpoint /api/worker/heartbeat queda deshabilitado.
WORKER_SECRET_KEY=
WEB_SERVER_URL=http://localhost:8000

# Dónde vive Pohua de cara al mundo: https://<tu-servicio>.onrender.com
# Se usa en el enlace del correo de recordatorio (abajo). Sin ella ese correo
# no se manda, porque el enlace apuntaría a localhost y no serviría de nada.
APP_URL=

# Arranca el worker de correo dentro del servidor web (1/true) o no.
WORKER_AUTOSTART=false

# Qué carpeta del buzón se lee. Vale para IMAP y para Graph.
# Para probar el flujo entero sin tocar la bandeja de ventas: crea una carpeta
# TEST en Outlook, mueve ahí un correo de RFQ y pon MAIL_FOLDER=TEST. Cuando
# el flujo esté validado, borra la línea y vuelve a INBOX.
MAIL_FOLDER=INBOX

# Cómo se entra al buzón: imap | graph | outlook.
#   imap     usuario y contraseña. En Microsoft 365 YA NO VALE: Microsoft
#            retiró la autenticación básica de IMAP y no se puede reactivar.
#   graph    aplicación registrada en Entra ID (AZURE_* + GRAPH_USER, abajo).
#   outlook  el Outlook de escritorio que ya tiene el buzón abierto, por COM.
#            No necesita credenciales; es el modo de la app de escritorio
#            (desktop_app/) y el respaldo cuando no hay permisos de Azure.
#            Necesita Windows, pywin32 y el Outlook CLÁSICO abierto.
MAIL_MODE=imap

# Sólo con MAIL_MODE=outlook: qué buzón leer de los que Outlook tenga abiertos.
# Vacío = el primero.
OUTLOOK_BUZON=

# ==============================================================================
# HORARIO DE ATENCIÓN
# ==============================================================================
# El ciclo lee el buzón de lunes a viernes, de 6:00 a 18:00. Fuera de esa
# ventana NO lo abre: el correo se queda sin leer donde está y entra en el
# primer ciclo de la apertura siguiente. Así no se contesta de madrugada y no
# se gasta el modelo de noche.
#
# La ventana vive en UN solo reloj —el de la planta— porque el ciclo es un
# proceso. La pantalla la dice en la ciudad del reloj de arriba (Kansas City en
# inglés, Querétaro en español, Sevran en francés).
#
# HORARIO_ACTIVO=false quita la restricción: se lee a cualquier hora.
# El botón "Ejecutar ciclo" de la pantalla Correo se salta el horario siempre.
HORARIO_ACTIVO=true
HORARIO_ZONA=America/Chicago
HORARIO_DESDE=6
HORARIO_HASTA=18
HORARIO_DIAS=1-5

# ==============================================================================
# RECORDATORIO DE LO QUE ESPERA DICTAMEN
# ==============================================================================
# El aviso principal es la campana de Pohua y la notificación del teléfono. Si
# un RFQ lleva más de estas horas esperando a una persona, sale ADEMÁS un
# correo (uno solo, queda apuntado) a los usuarios de Pohua con permiso
# rfq:dictaminar, con el enlace al caso. Necesita APP_URL. 0 lo apaga.
RECORDATORIO_HORAS=4

# ==============================================================================
# @Local@ - CONFIGURACIÓN DE CORREO TRADICIONAL
# ==============================================================================
AUTH_METHOD=local
IMAP_SERVER=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USE_TLS=True

# Minutos entre ciclos de lectura del buzón.
INTERVALO_MINUTOS=5

# Interruptor del envío automático de respuestas al comprador (COT-36).
# Apagado por defecto: el correo se construye y se registra, pero no sale.
ENVIO_AUTOMATICO=False

# Volver a procesar un correo que YA se procesó (mismo Message-ID).
# Sólo para ensayar el flujo: deja repetir el mismo correo de prueba en vez de
# tener que mandar uno nuevo cada vez. Encendido, el registro lo avisa en cada
# ciclo. En operación va apagado: si no, un correo daría dos RFQ y dos
# respuestas al mismo comprador.
REPROCESAR_REPETIDOS=false

# Logo de la firma de los correos al cliente. Vacío = el del proyecto
# (app/email/assets/firma.png). Va incrustado en el mensaje, no enlazado: las
# imágenes remotas llegan bloqueadas en casi todos los clientes de correo.
FIRMA_IMAGEN=

# Web Push: los avisos de la campana también en el teléfono (con Pohua
# cerrada). Genera el par con `python scripts/generar_vapid.py` y pega las dos
# claves aquí (y en Render). Sin ellas la campana funciona igual dentro de la
# app; sólo no llega nada al teléfono.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:...   (opcional; por defecto, el buzón configurado)

# Dónde se dejan los PDF de las ofertas al cliente. Por defecto vendor/Quotes
# (ignorada por git), la misma carpeta que usa el lector de ISC.
# QUOTES_DIR=

# ==============================================================================
# @Token@ - MICROSOFT GRAPH (alternativa a IMAP; AUTH_METHOD=token)
# ==============================================================================
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
GRAPH_USER=

# ==============================================================================
# CONFIGURACIÓN DE IA
# ==============================================================================
ANTHROPIC_API_KEY=
VISION_MODEL=claude-opus-4-8
LLM_MODEL=claude-sonnet-4-6
UMBRAL_CONFIANZA=0.7

# ==============================================================================
# ALMACENAMIENTO DE PLANOS (COT-56)
# ==============================================================================
# <Local>: carpeta en disco.  <Token>: contenedor de Azure Blob Storage.
PLANOS_DIR=planos
BLOB_CONNECTION_STRING=
BLOB_CONTAINER=planos

# ==============================================================================
# FACTIBILIDAD (COT-74)
# ==============================================================================
REGLAS_FACTIBILIDAD=reglas/factibilidad.json

# ==============================================================================
# NOMBRES VIEJOS QUE SIGUEN VALIENDO
# ==============================================================================
# La configuración acepta los dos nombres y los sincroniza sola, así que un
# .env de antes sigue funcionando. Si ves uno de éstos por ahí, es el mismo
# dato con otro nombre:
#
#   AUTH_METHOD        = MAIL_MODE        (local ↔ imap, token ↔ graph)
#   IMAP_SERVER        = IMAP_HOST
#   MAIL_FOLDER        = IMAP_FOLDER
#   AZURE_CLIENT_ID    = GRAPH_CLIENT_ID      (y TENANT_ID / CLIENT_SECRET)
#   DATABASE_URL       = PG_HOST + PG_PORT + PG_DATABASE + PG_USER + PG_PASSWORD
#
# Con DATABASE_URL puesta manda ella y las PG_* se derivan de su contenido.
